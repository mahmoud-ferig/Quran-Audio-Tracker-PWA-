rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own listening progress
    match /listening_progress/{docId} {
      allow read, write: if true;
    }
    
    // Allow users to read and write their favorites
    match /user_favorites/{userId} {
      allow read, write: if true;
    }

    // Allow users to read and write their personal settings
    match /user_settings/{userId} {
      allow read, write: if true;
    }
  }
}
